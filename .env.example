# No env vars are required for local development (`npm run dev`).
#
# Phase 1+ (documented here so nothing lands in code without a home):
#
# SUPABASE_URL=            # project URL — build-time reads + /api/* writes
# SUPABASE_SERVICE_KEY=    # service role key. NEVER the anon key; tables live in a
#                          # non-exposed schema with RLS on (see PRD §6.2)
# GITHUB_TOKEN=            # PAT for the nightly stats refresh (GraphQL + REST)
# DATAFAST_WEBSITE_ID=     # dfid_… — analytics script tag in Base.astro (Phase 3)
