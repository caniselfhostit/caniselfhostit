# Cache policy for Workers static assets (Cloudflare honors this file).
# HTML must never go stale across deploys: revalidate every time (cheap 304s
# via asset ETags). Hashed /_astro/* assets get their immutable rule appended
# below by @astrojs/cloudflare at build time, overriding the catch-all.
/*
  Cache-Control: public, max-age=0, must-revalidate

# OG cards change rarely and carry a ?v= build-id buster in every meta tag,
# so a short edge TTL is safe and keeps social scrapers fast.
/og/*
  Cache-Control: public, max-age=3600

# Hashed build assets are immutable by construction (declared here explicitly:
# the adapter only auto-injects this rule when no user _headers file exists).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The agent-readable mirrors are not pages — they are the same facts as
# /self-host/<slug>/ with the chrome stripped, advertised in robots.txt and
# llms.txt so a model can read them in one fetch. Google crawled ~80 of them
# and filed every one under "Crawled - currently not indexed", which is the
# right verdict reached the expensive way: duplicates of pages it already has.
# noindex says it up front. Crawling stays allowed — the mirrors exist to be
# fetched, just not ranked. A meta tag is impossible here (text/markdown has no
# <head>), so the header is the only channel.
#
# The `*.md` suffix glob is load-bearing: /self-host/* would put noindex on the
# HTML answer pages, which are the entire point of the site. Verified locally
# against wrangler — the mirrors get the header, /self-host/<slug>/ does not.
/self-host/*.md
  X-Robots-Tag: noindex

# Same reasoning, exact path: /llms.txt is an index for agents, and its entries
# all point at the .md mirrors above. Indexing a link list whose every target is
# noindexed adds nothing to search and spends crawl budget saying so.
/llms.txt
  X-Robots-Tag: noindex
