---
// The Swap: the whole product in one band. Left is the invoice you already pay,
// right is the thing you'd run instead. The arrow is copper because it is
// machinery, not a verdict.
const { payingName, payingPrice, runningName, runningMeta } = Astro.props;
---

<div class="swap">
  <div class="swap-panel is-paying">
    <p class="microlabel">You're paying</p>
    <p class="swap-name">{payingName}</p>
    {payingPrice && <p class="swap-figure">{payingPrice}</p>}
  </div>

  <div class="swap-arrow" aria-hidden="true">
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 12h15"></path>
      <path d="M13 6l6 6-6 6"></path>
    </svg>
  </div>
  <span class="sr-only">is replaced by</span>

  <div class="swap-panel is-running">
    <p class="microlabel">You'd run</p>
    <p class="swap-name">{runningName}</p>
    {runningMeta && <p class="swap-figure">{runningMeta}</p>}
  </div>
</div>
