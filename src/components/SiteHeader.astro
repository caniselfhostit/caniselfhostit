---
import { SITE } from '../lib/site.js';

const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: 'Directory' },
  { href: '/prompt-zero/', label: 'Prompt Zero' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/contribute/', label: 'Contribute' },
];
const current = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/" aria-label={`${SITE.name} — home`}>
      can i self-host it<span class="q" aria-hidden="true">?</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="gh" href={SITE.repoUrl} target="_blank" rel="noopener">GitHub ↗</a>
      <button
        class="theme-toggle"
        type="button"
        data-toggle-theme
        aria-label="Switch between light and dark theme"
      >
        <svg
          class="moon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg
          class="sun"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
