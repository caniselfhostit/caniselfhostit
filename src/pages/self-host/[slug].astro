---
/* The project page — the template every project on this site renders through.
 *
 * The rule that shapes the whole file: nothing on this page is written twice.
 * The verdict word, the direct answer, the savings figure, the FAQ answers, the
 * structured data and the meta description are all derived here, once, from the
 * typed fields in data/projects/<slug>/index.json. That is what keeps the number
 * in the title equal to the number in the badge equal to the number a crawler
 * reads out of the JSON-LD.
 *
 * The second rule: this page does not claim a stamp it has not earned. Until the
 * harness (PRD §9) records a run, the unverified notice sits above the prompt in
 * plain sight — not in a footer, not in grey 11px type.
 */
import Base from '../../layouts/Base.astro';
import BeforeYouStart from '../../components/BeforeYouStart.astro';
import FallbackFile from '../../components/FallbackFile.astro';
import ProjectFaq from '../../components/ProjectFaq.astro';
import PromptBox from '../../components/PromptBox.astro';
import SwapBand from '../../components/SwapBand.astro';
import TierBadge from '../../components/TierBadge.astro';
import { SITE, pageTitle } from '../../lib/site.js';
import { getAllProjects, getProjectFiles, relatedProjects, tierBandLabel } from '../../lib/projects.js';
import { OFFICIAL_COMPOSE } from '../../lib/rubric.js';

export function getStaticPaths() {
  return getAllProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project: p } = Astro.props;
const files = getProjectFiles(p.slug);
const related = relatedProjects(p, 3);

const pageUrl = `${SITE.origin}/self-host/${p.slug}/`;
const isVerified = p.verified?.status === 'verified';

/* ------------------------------------------------------------------ *
 * Money
 * ------------------------------------------------------------------ */

const money = (n) =>
  `$${n.toLocaleString('en-US', {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;

// `replaces` lists ALTERNATIVES, so the headline is the largest single bill in
// the list — never the sum. Nobody pays for 1Password and LastPass at once.
const replaces = p.replaces ?? [];
const priced = replaces
  .filter((r) => typeof r.monthlyCost === 'number' && r.monthlyCost > 0)
  .sort((a, b) => b.monthlyCost - a.monthlyCost);
const swap = priced[0] ?? replaces[0] ?? null;
const swapPriced = swap && typeof swap.monthlyCost === 'number' && swap.monthlyCost > 0;
const seatNote = swap && swap.seatsAssumed > 1 ? `, ${swap.seatsAssumed} seats assumed` : '';

/* ------------------------------------------------------------------ *
 * The direct answer — generated, never hand-written (PRD §5.3)
 * ------------------------------------------------------------------ */

const sentence = (items) =>
  items.length <= 1
    ? (items[0] ?? '')
    : `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;

const answerClauses = [
  p.ramMinMB ? `runs on a ${p.ramMinMB} MB VPS` : null,
  p.timeToRunningMin ? `takes about ${p.timeToRunningMin} minutes to a first backup` : null,
  swapPriced
    ? `replaces ${swap.name} at ${money(swap.monthlyCost)}/mo (${money(swap.yearlyCost)}/yr${seatNote})`
    : swap
      ? `replaces ${swap.name}; no like-for-like price to quote`
      : null,
].filter(Boolean);

const directAnswer = answerClauses.length
  ? `${p.verdictWord}. ${p.name} ${sentence(answerClauses)}.`
  : `${p.verdictWord}. ${p.name} is self-hostable, and the running numbers for this page are not filled in yet.`;

/* ------------------------------------------------------------------ *
 * Head
 * ------------------------------------------------------------------ */

const title = pageTitle(p.name, p.tier, p.timeToRunningMin);
const description = [
  `${p.verdictWord} — ${p.tierLabel.toLowerCase()}.`,
  p.ramMinMB && p.timeToRunningMin
    ? `${p.name} runs in ${p.ramMinMB} MB of RAM, about ${p.timeToRunningMin} minutes to running.`
    : `${p.name}, self-hosted on your own server.`,
  swapPriced ? `Replaces ${swap.name} at ${money(swap.monthlyCost)}/mo.` : null,
  'Prompt, compose.yml, Caddyfile, install.sh.',
]
  .filter(Boolean)
  .join(' ');

/* ------------------------------------------------------------------ *
 * FAQ — one array, rendered as <details> AND as FAQPage. Answers are plain
 * strings so the structured data is byte-identical to the visible text.
 * ------------------------------------------------------------------ */

const containers = p.tierFactors?.containers ?? 1;
const containerPhrase = containers === 1 ? 'one container' : `${containers} containers`;
const bandLabel = tierBandLabel(p.tier);

// A class of VPS, not a quote from a vendor: the smallest tier most hosts sell
// runs anything under a gigabyte, and saying "about $5" is honest where naming a
// provider's current price would be a number we did not check today.
const vpsClass =
  !p.ramMinMB || p.ramMinMB <= 1024
    ? 'about $5 a month'
    : p.ramMinMB <= 2048
      ? 'about $10 a month'
      : 'about $20 a month';

const faqs = [
  {
    q: `How do I self-host ${p.name}?`,
    a:
      `Two prompts. Prompt Zero prepares the server once — Docker, a firewall, an ssh alias — and then the prompt on this page installs ${p.name}: ` +
      `${containerPhrase} behind Caddy with automatic TLS, secrets generated on the server rather than in a chat window, and a first backup taken before the agent tells you it is done. ` +
      (p.timeToRunningMin ? `Budget about ${p.timeToRunningMin} minutes. ` : '') +
      `If you have no terminal agent, the chat fallback on this page walks the same install one command at a time, and the compose.yml, Caddyfile and install.sh below do it with no agent at all.`,
  },
  {
    q: `What does ${p.name} cost to run?`,
    a:
      `${p.ramMinMB ? `${p.ramMinMB} MB of RAM` : 'A small amount of RAM'}${p.diskGB ? ` and ${p.diskGB} GB of disk` : ''} — the smallest tier most VPS hosts sell, ${vpsClass}. ` +
      `${p.name} itself is free${p.license ? ` and ${p.license}-licensed` : ''}; the bill is the server, plus a domain you probably already own. ` +
      (swapPriced
        ? `What you stop paying: ${swap.name} ${swap.plan}, ${money(swap.monthlyCost)}/mo — ${money(swap.yearlyCost)} a year${seatNote}.`
        : swap
          ? `What you stop paying depends on which ${swap.name} plan you are on; there is no single list price to quote here, so this page does not invent one.`
          : `Nothing here replaces a subscription with a list price, so there is no savings figure on this page.`),
  },
  {
    q: swap ? `What do I give up versus ${swap.name}?` : `What do I give up by self-hosting this?`,
    a:
      `Someone else's operational responsibility becomes yours. ` +
      (p.whatYouSignUpFor ?? []).slice(0, 3).join(' '),
  },
  {
    q: 'How hard is it really?',
    a:
      `${p.tierLabel}${bandLabel ? ` — ${bandLabel}` : ''}. ` +
      `The rule that produced that verdict: ${p.tierRule.test}. ${p.tierRule.because} ` +
      `The tier is derived from seven countable facts about the install, not from anyone's impression of it, and the whole rubric is published on the methodology page.`,
  },
];

/* ------------------------------------------------------------------ *
 * Structured data
 * ------------------------------------------------------------------ */

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      // The category shelf has no page yet, so this item carries a name and no
      // `item` — the trail matches the visible breadcrumb, and nothing points a
      // crawler at a URL that would 404. It gains `item` when /category/ ships.
      { '@type': 'ListItem', position: 2, name: p.categoryLabel },
      { '@type': 'ListItem', position: 3, name: p.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    // AEO plumbing, not a rich-result play: SoftwareApplication cannot earn its
    // rich result without ratings, and there is no aggregateRating here until
    // real crawlable reviews exist (PRD §10.6).
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: p.name,
    description: p.tagline,
    applicationCategory: p.categoryLabel,
    operatingSystem: 'Linux (Docker)',
    url: pageUrl,
    ...(p.repo ? { sameAs: `https://github.com/${p.repo}` } : {}),
    ...(p.license ? { license: p.license } : {}),
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  },
];

/* ------------------------------------------------------------------ *
 * Small bits of chrome
 * ------------------------------------------------------------------ */

const composeLabel = OFFICIAL_COMPOSE[p.officialCompose] ?? null;
const swapMeta = [
  p.tierLabel,
  p.timeToRunningMin ? `~${p.timeToRunningMin} min to running` : null,
  p.ramMinMB ? `${p.ramMinMB} MB RAM` : null,
]
  .filter(Boolean)
  .join(' · ');

const fallbacks = [
  {
    filename: 'compose.yml',
    text: files.compose,
    id: `f-compose-${p.slug}`,
    summary: 'the services, pinned',
    sourceUrl: p.sources?.compose ?? null,
  },
  {
    filename: 'Caddyfile',
    text: files.caddyfile,
    id: `f-caddy-${p.slug}`,
    summary: 'the hostname and TLS',
    sourceUrl: p.sources?.caddy ?? null,
  },
  {
    filename: 'install.sh',
    text: files.installSh,
    id: `f-install-${p.slug}`,
    summary: 'the same install, no agent',
    sourceUrl: p.sources?.install ?? p.sources?.compose ?? null,
  },
].filter((f) => typeof f.text === 'string' && f.text.length > 0);

const citations = (p.citations ?? []).filter((c) => c?.url);
const mirrorHref = `/self-host/${p.slug}.md`;
---

<Base {title} {description} {jsonld} ogImage={`/og/${p.slug}.png`}>
  <article class="project">
    <!-- ── head ─────────────────────────────────────────────────────── -->
    <header class="ph blueprint">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span>{p.categoryLabel}</span></li>
            <li><span aria-current="page">{p.name}</span></li>
          </ol>
        </nav>

        <div class="ph-verdict">
          <h1>Can I self-host {p.name}?</h1>
          <TierBadge tier={p.tier} label={`${p.verdictWord} · ${p.tierLabel}`} size="lg" />
        </div>

        <p class="ph-answer">{directAnswer}</p>
        <p class="ph-tagline">{p.tagline}</p>

        <ul class="ph-meta" aria-label={`Facts about ${p.name}`}>
          {p.license && <li class="chip mono">{p.license}</li>}
          {
            p.repo && (
              <li>
                <a class="chip mono" href={`https://github.com/${p.repo}`} rel="noopener">
                  {p.repo}
                </a>
              </li>
            )
          }
          {
            composeLabel && (
              <li>
                {p.officialComposeUrl ? (
                  <a class="chip" href={p.officialComposeUrl} rel="noopener">{composeLabel}</a>
                ) : (
                  <span class="chip">{composeLabel}</span>
                )}
              </li>
            )
          }
          {p.arm64 !== null && <li class="chip">{p.arm64 ? 'runs on arm64' : 'amd64 only'}</li>}
        </ul>
      </div>
    </header>

    <!-- ── the swap ─────────────────────────────────────────────────── -->
    {
      swap && (
        <section class="section pj-swap" aria-labelledby="swap-h">
          <div class="wrap">
            <h2 class="microlabel" id="swap-h">The swap</h2>
            <SwapBand
              payingName={swap.name}
              payingPrice={
                swapPriced
                  ? `${money(swap.monthlyCost)}/mo · ${money(swap.yearlyCost)}/yr`
                  : 'no list price to quote'
              }
              runningName={p.name}
              runningMeta={swapMeta}
            />
            <p class="provenance swap-prov">
              {swap.plan && <>{swap.name} {swap.plan}{seatNote ? seatNote.replace(/^, /, ' · ') : ''} · </>}
              {
                swapPriced ? (
                  <>
                    vendor list price
                    {swap.priceCheckedOn ? <> · checked {swap.priceCheckedOn}</> : null}
                    {swap.priceSource ? (
                      <> · <a href={swap.priceSource} rel="noopener nofollow">source</a></>
                    ) : null}
                    {swap.priceConfidence && swap.priceConfidence !== 'high' ? (
                      <> · confidence: {swap.priceConfidence}</>
                    ) : null}
                  </>
                ) : (
                  <>no like-for-like list price on the vendor's page, so this page quotes none</>
                )
              }
            </p>
          </div>
        </section>
      )
    }

    <!-- ── before you start ─────────────────────────────────────────── -->
    <section class="section pj-bys" aria-labelledby="bys-h">
      <div class="wrap">
        <h2 class="microlabel" id="bys-h">Before you start</h2>
        <BeforeYouStart
          ramMinMB={p.ramMinMB}
          ramMeasuredMB={p.ramMeasuredMB}
          diskGB={p.diskGB}
          needsDns={p.tierFactors?.needsDns ?? false}
          timeToRunningMin={p.timeToRunningMin}
          bandLabel={bandLabel}
        />
      </div>
    </section>

    <!-- ── the prompt, and the notice that has to sit above it ──────── -->
    <section class="section pj-prompt" id="the-prompt" aria-labelledby="prompt-h">
      <div class="wrap">
        {
          isVerified ? (
            <p class="stamp verify-stamp">
              Tested on a clean machine
              {p.verified?.date ? ` · ${p.verified.date}` : ''}
              {p.verified?.version ? ` · ${p.verified.version}` : ''}
              {p.verified?.host ? ` · ${p.verified.host}` : ''}
            </p>
          ) : (
            <aside class="unverified" aria-labelledby="unverified-h">
              <p class="microlabel" id="unverified-h">Not yet verified on a clean machine</p>
              <p>
                Every config here was authored from the upstream docs and passes our static checks —
                but no harness run has stamped this page yet. The verification system is described on{' '}
                <a href="/methodology/">/methodology</a>.
              </p>
              <p class="unverified-ask">
                Ran it? Tell us:{' '}
                <a href={`${SITE.repoUrl}/issues/new/choose`} rel="noopener">
                  open an issue
                </a>{' '}
                with what worked and what did not. That is how this page earns its stamp.
              </p>
            </aside>
          )
        }

        <div class="section-head">
          <div>
            <h2 id="prompt-h">The prompt</h2>
            <p class="section-note">
              One prompt, assuming Prompt Zero is done. Read it before you paste it — that is the
              whole reason it is on the page instead of behind a download.
            </p>
          </div>
        </div>

        <PromptBox
          name={p.name}
          slug={p.slug}
          prompt={files.prompt}
          promptChat={files.promptChat}
          promptLocal={files.promptLocal}
          mirrorHref={mirrorHref}
        />
      </div>
    </section>

    <!-- ── deterministic fallback files ─────────────────────────────── -->
    {
      fallbacks.length > 0 && (
        <section class="section pj-files" id="the-files" aria-labelledby="files-h">
          <div class="wrap">
            <div class="section-head machine">
              <div>
                <h2 id="files-h">The files, if you'd rather do it yourself</h2>
                <p class="section-note">
                  The same install with no agent involved: three files, in the order you'd use them.
                  The prompt above writes exactly these — if the two ever disagree, the files are the
                  ones CI diffs.
                </p>
              </div>
            </div>
            <div class="ff-list">
              {fallbacks.map((f) => (
                <FallbackFile
                  filename={f.filename}
                  text={f.text}
                  id={f.id}
                  summary={f.summary}
                  sourceUrl={f.sourceUrl}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ── what you're signing up for ───────────────────────────────── -->
    {
      (p.whatYouSignUpFor ?? []).length > 0 && (
        <section class="section pj-candor" id="signing-up" aria-labelledby="candor-h">
          <div class="wrap">
            <div class="section-head">
              <div>
                <h2 id="candor-h">What you're signing up for</h2>
                <p class="section-note">
                  The part a vendor's comparison page leaves out. None of it is a reason not to do
                  this; all of it is yours the moment you do.
                </p>
              </div>
            </div>
            <ul class="candor">
              {p.whatYouSignUpFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ── provenance: the quote and the citations ──────────────────── -->
    {
      (p.quote?.text || citations.length > 0) && (
        <section class="section pj-sources" aria-labelledby="sources-h">
          <div class="wrap">
            <h2 class="microlabel" id="sources-h">Where this came from</h2>
            {p.quote?.text && (
              <blockquote class="pj-quote machine">
                <p>“{p.quote.text}”</p>
                <footer class="provenance">
                  —{' '}
                  {p.quote.url ? (
                    <a href={p.quote.url} rel="noopener">{p.quote.source}</a>
                  ) : (
                    p.quote.source
                  )}
                  {p.quote.checkedOn ? ` · read ${p.quote.checkedOn}` : ''}
                </footer>
              </blockquote>
            )}
            {citations.length > 0 && (
              <ul class="cites">
                {citations.map((c) => (
                  <li>
                    <span class="cite-claim">{c.claim}</span>{' '}
                    <a class="cite-link mono" href={c.url} rel="noopener">source</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      )
    }

    <!-- ── related ──────────────────────────────────────────────────── -->
    {
      related.length > 0 && (
        <section class="section pj-related" aria-labelledby="related-h">
          <div class="wrap">
            <div class="section-head">
              <div>
                <h2 id="related-h">If you're already in here</h2>
                <p class="section-note">
                  Same shelf, same kind of evening. Each one has its own prompt.
                </p>
              </div>
            </div>
            <ul class="mini-cards" role="list">
              {related.map((r) => (
                <li>
                  <a class="mini-card" href={`/self-host/${r.slug}/`}>
                    <span class="mc-top">
                      <span class="mc-name">{r.name}</span>
                      <TierBadge tier={r.tier} label={r.tierLabel} />
                    </span>
                    <span class="mc-tagline">{r.tagline}</span>
                    <span class="mc-cta mono">Can I self-host {r.name}? →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ── faq ──────────────────────────────────────────────────────── -->
    <section class="section pj-faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="faq-h">Questions people actually ask</h2>
            <p class="section-note">
              Answered from this page's own data — the same numbers, in sentences.
            </p>
          </div>
        </div>
        <ProjectFaq faqs={faqs} />
        <p class="provenance faq-foot">
          Content last checked {p.contentUpdatedAt}. Verdicts are derived from the published rubric
          on <a href="/methodology/">/methodology</a>; corrections go through{' '}
          <a href={`${SITE.repoUrl}/issues/new/choose`} rel="noopener">the issue tracker</a>.
        </p>
      </div>
    </section>
  </article>
</Base>
