---
/* The answer page — one per PAID app, and the canonical URL for everything this
 * site knows.
 *
 * The narrative inversion, stated once so the rest of the file reads straight:
 * the protagonist is the subscription. The H1 asks the question a reader
 * actually types — "can I self-host Miro?" — and the open-source project is the
 * ANSWER to it, not the subject of it. Everything the old project-keyed template
 * did well survives here, re-pointed at page.primary: the generated direct
 * answer, the prompt above the fold, the unverified notice at full contrast, the
 * candor list, the citations, the FAQ machinery.
 *
 * Two rules shape the whole file.
 *
 * 1. Nothing is written twice. The verdict word, the direct answer, the FAQ
 *    answers, the meta description and the structured data are all derived here
 *    from the typed fields in data/ — that is what keeps the number in the title
 *    equal to the number in the badge equal to the number a crawler reads out of
 *    the JSON-LD.
 *
 * 2. Every money figure on this page comes from ONE object: `page.swap`, the
 *    primary project's resolved swap for THIS SaaS, already seat-multiplied and
 *    already dated by the data layer. The .md mirror quotes the same object, so
 *    the two cannot drift. A swap with no honest price prints no number at all
 *    rather than a zero.
 *
 * And the standing rule underneath both: this page does not claim a stamp it has
 * not earned. Until the harness (PRD §9) records a run, the unverified notice
 * sits above the prompt in plain sight.
 */
import Base from '../../layouts/Base.astro';
import BeforeYouStart from '../../components/BeforeYouStart.astro';
import FallbackFile from '../../components/FallbackFile.astro';
import ProjectFaq from '../../components/ProjectFaq.astro';
import PromptBox from '../../components/PromptBox.astro';
import SwapBand from '../../components/SwapBand.astro';
import TierBadge from '../../components/TierBadge.astro';
import { SITE, pageTitle } from '../../lib/site.js';
import {
  getAllSaasPages,
  getProjectFiles,
  relatedSaasPages,
  tierBandLabel,
} from '../../lib/projects.js';
import { OFFICIAL_COMPOSE } from '../../lib/rubric.js';

export function getStaticPaths() {
  return getAllSaasPages().map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// `p` is the REPLACEMENT — the thing we install, and the subject of every
// install artifact below. The page itself is about `page`, the thing you pay.
const p = page.primary;
const files = getProjectFiles(p.slug);
const related = relatedSaasPages(page, 3);
const runnersUp = page.options.slice(1);
const pickRationale = page.options[0]?.rationale ?? null;

const pageUrl = `${SITE.origin}/self-host/${page.slug}/`;
const isVerified = p.verified?.status === 'verified';

/* ------------------------------------------------------------------ *
 * Money — one object, quoted everywhere
 * ------------------------------------------------------------------ */

const money = (n) =>
  `$${n.toLocaleString('en-US', {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;

const swap = page.swap;
const swapPriced = !!swap && typeof swap.monthlyCost === 'number' && swap.monthlyCost > 0;

// How the vendor bills decides what the figure is allowed to claim. A per-seat
// price is a bill for a stated number of seats; a metered price is a rate, and
// calling it a bill would be the exact dishonesty this site exists to call out.
const seats = swap?.seatsAssumed ?? 1;
const seatNote =
  swap?.unit === 'per-seat' ? `${seats} seat${seats === 1 ? '' : 's'} assumed` : null;
const meterNote = swap?.unit === 'usage' ? 'a metered rate, not a whole bill' : null;
const qualifier = [seatNote, meterNote].filter(Boolean).join(', ');
const qualifierClause = qualifier ? `, ${qualifier}` : '';

const monthlyLine = swapPriced ? `${money(swap.monthlyCost)}/mo` : null;
const yearlyLine = swapPriced ? `${money(swap.yearlyCost)}/yr` : null;

/* ------------------------------------------------------------------ *
 * The direct answer — generated, never hand-written (PRD §5.3)
 * ------------------------------------------------------------------ */

const sentence = (items) => {
  const list = items.filter(Boolean);
  return list.length <= 1
    ? (list[0] ?? '')
    : `${list.slice(0, -1).join(', ')}, and ${list[list.length - 1]}`;
};

const setupClause = sentence([
  'one prompt',
  p.ramMinMB ? `a ${p.ramMinMB} MB VPS` : null,
  p.timeToRunningMin ? `about ${p.timeToRunningMin} minutes` : null,
]);

const moneySentence = swapPriced
  ? `That is ${money(swap.monthlyCost)} a month you stop paying ${page.name} — ` +
    `${money(swap.yearlyCost)} a year on the ${swap.plan} plan${qualifierClause}.`
  : `There is no like-for-like ${page.name} price to quote for this swap, so this page quotes none.`;

const directAnswer =
  `${page.verdictWord} — it's called ${p.name}. ` +
  (setupClause ? `It takes ${setupClause}. ` : '') +
  moneySentence;

/* ------------------------------------------------------------------ *
 * Head
 * ------------------------------------------------------------------ */

const title = pageTitle(page.name, page.tier, p.name);
const description = [
  `${page.verdictWord} — ${p.name} is the replacement.`,
  p.ramMinMB && p.timeToRunningMin
    ? `${p.ramMinMB} MB of RAM, about ${p.timeToRunningMin} minutes to running.`
    : `${p.name}, self-hosted on your own server.`,
  swapPriced ? `Stops ${monthlyLine} — ${yearlyLine}.` : null,
  'One prompt, plus compose.yml, Caddyfile and install.sh.',
]
  .filter(Boolean)
  .join(' ');

/* ------------------------------------------------------------------ *
 * Pricing provenance
 * ------------------------------------------------------------------ */

const pricing = page.pricing ?? {};
const lowConfidence = pricing.confidence === 'low';
const showCaveat = !!pricing.note && pricing.confidence && pricing.confidence !== 'high';

// `TODO: …` in a pricing note is an instruction to us, not to the reader. The
// sentence is stripped; everything after it — which is the actual explanation of
// why the number is soft — prints verbatim.
const caveatNote = (pricing.note ?? '').replace(/^\s*TODO:[^.]*\.\s*/i, '').trim();

const PRICE_UNIT_SUFFIX = {
  'per-seat': ' per seat',
  'per-host': ' per host',
  usage: ' metered',
  'one-time': ' one-time',
  flat: '',
  custom: '',
};

function planPrice(plan) {
  if (typeof plan.priceMonthly !== 'number') return 'quote only';
  if (plan.priceMonthly === 0) return 'free';
  return `${money(plan.priceMonthly)}/mo${PRICE_UNIT_SUFFIX[plan.unit] ?? ''}`;
}

/* ------------------------------------------------------------------ *
 * FAQ — one array, rendered as <details> AND as FAQPage. Answers are plain
 * strings so the structured data is byte-identical to the visible text.
 * ------------------------------------------------------------------ */

const containers = p.tierFactors?.containers ?? 1;
const containerPhrase = containers === 1 ? 'one container' : `${containers} containers`;
const bandLabel = tierBandLabel(p.tier);

// A class of VPS, not a quote from a vendor: the smallest tier most hosts sell
// runs anything under a gigabyte, and saying "about $5" is honest where naming a
// provider's current price would be a number we did not check today.
const vpsClass =
  !p.ramMinMB || p.ramMinMB <= 1024
    ? 'about $5 a month'
    : p.ramMinMB <= 2048
      ? 'about $10 a month'
      : 'about $20 a month';

// The local path. `local` is authored in index.json alongside the prompt, so a
// project whose local prompt is still being written has neither — the answer
// below says that rather than describing a panel that carries nothing.
const localFit = p.local?.fit ?? null;
const localNote = p.local?.note ?? null;
const localReady = typeof files.promptLocal === 'string' && files.promptLocal.length > 0;

const faqs = [
  {
    q: `Can I self-host ${page.name}?`,
    a:
      `Not ${page.name} itself — the vendor does not ship a version you can run on your own server. ` +
      `What you can self-host is the job people pay it for, and the answer to that is ${p.name}. ${p.tagline} ` +
      `The install is ${p.tierLabel.toLowerCase()}: ${containerPhrase} behind Caddy with automatic TLS, secrets generated on the server rather than in a chat window, and a first backup taken before the agent says it is done` +
      (p.timeToRunningMin ? `, in about ${p.timeToRunningMin} minutes. ` : '. ') +
      `The prompt on this page does it; the compose.yml, Caddyfile and install.sh below do the same install with no agent at all.`,
  },
  {
    q: `What replaces ${page.name}?`,
    a:
      `${p.name}. ${p.tagline}` +
      (pickRationale ? ` ${pickRationale}` : '') +
      (runnersUp.length
        ? ` Also evaluated and ranked below it: ${runnersUp.map((o) => o.name).join(', ')}. The prompt on this page installs ${p.name} only.`
        : '') +
      (p.license ? ` ${p.name} is ${p.license}-licensed and free; nothing on this page is a hosted service we sell you.` : ''),
  },
  {
    q: `What does self-hosting cost compared to ${page.name}?`,
    a:
      `${p.ramMinMB ? `${p.ramMinMB} MB of RAM` : 'A small amount of RAM'}${p.diskGB ? ` and ${p.diskGB} GB of disk` : ''} — the smallest tier most VPS hosts sell, ${vpsClass}. ` +
      `${p.name} itself is free${p.license ? ` and ${p.license}-licensed` : ''}; the bill is the server, plus a domain you probably already own. ` +
      (swapPriced
        ? `What you stop paying: ${page.name} ${swap.plan}, ${money(swap.monthlyCost)}/mo — ${money(swap.yearlyCost)} a year${qualifierClause}.`
        : `There is no like-for-like ${page.name} list price behind this swap, so this page does not invent a savings figure.`),
  },
  {
    q: 'How hard is it really?',
    a:
      `${p.tierLabel}${bandLabel ? ` — ${bandLabel}` : ''}. ` +
      `The rule that produced that verdict: ${p.tierRule.test}. ${p.tierRule.because} ` +
      `The tier is derived from seven countable facts about the ${p.name} install, not from anyone's impression of it, and the whole rubric is published on the methodology page.`,
  },
  {
    q: `Can I run ${p.name} on my own computer instead of a server?`,
    a:
      `Yes — that is the second path in the prompt box above. "On my computer" installs the same ${p.name} on the machine you are sitting at: no VPS, no domain, no DNS, and nothing exposed to the internet. ` +
      `It checks for Docker first and installs Docker Desktop if the machine does not have it — macOS, Windows and Linux each get their own step — then binds everything to loopback, so the app answers on http://localhost and only on that computer. ` +
      (localNote ? `${localFit === 'caveat' ? 'The catch' : 'Worth knowing'}: ${localNote} ` : '') +
      (localReady
        ? `Same discipline as the cloud path: pinned images, secrets generated on the machine, and a first backup taken before the prompt says it is done.`
        : `The local prompt for ${p.name} is not written yet, so that panel says so rather than handing you something nobody authored.`),
  },
];

/* ------------------------------------------------------------------ *
 * Structured data
 * ------------------------------------------------------------------ */

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    // Home › shelf › product, and every step carries `item`. Google requires a
    // URL on every ListItem except the last, and a middle crumb without one
    // invalidates the entire trail rather than dropping that step — which is the
    // error Search Console reported while /category/ was still unbuilt. The
    // shelf has a real page now (src/pages/category/[category].astro), so the
    // middle step points at it. The last step keeps its `item` too: it is this
    // page's own canonical and it resolves.
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.origin}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: page.categoryLabel,
        item: `${SITE.origin}/category/${page.category}/`,
      },
      { '@type': 'ListItem', position: 3, name: page.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    // The application marked up here is the OPEN-SOURCE REPLACEMENT, never the
    // SaaS: we do not publish Miro, and claiming its name in our own
    // SoftwareApplication block would be a lie told to a crawler. AEO plumbing
    // only — no aggregateRating until real crawlable reviews exist (PRD §10.6).
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: p.name,
    description: p.tagline,
    applicationCategory: p.categoryLabel,
    operatingSystem: 'Linux, macOS, Windows (Docker)',
    url: pageUrl,
    ...(p.repo ? { sameAs: `https://github.com/${p.repo}` } : {}),
    ...(p.license ? { license: p.license } : {}),
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  },
];

/* ------------------------------------------------------------------ *
 * Small bits of chrome
 * ------------------------------------------------------------------ */

const composeLabel = OFFICIAL_COMPOSE[p.officialCompose] ?? null;
const swapMeta = [
  p.tierLabel,
  p.timeToRunningMin ? `~${p.timeToRunningMin} min to running` : null,
  p.ramMinMB ? `${p.ramMinMB} MB RAM` : null,
]
  .filter(Boolean)
  .join(' · ');

const fallbacks = [
  {
    filename: 'compose.yml',
    text: files.compose,
    id: `f-compose-${p.slug}`,
    summary: 'the services, pinned',
    sourceUrl: p.sources?.compose ?? null,
  },
  {
    filename: 'Caddyfile',
    text: files.caddyfile,
    id: `f-caddy-${p.slug}`,
    summary: 'the hostname and TLS',
    sourceUrl: p.sources?.caddy ?? null,
  },
  {
    filename: 'install.sh',
    text: files.installSh,
    id: `f-install-${p.slug}`,
    summary: 'the same install, no agent',
    sourceUrl: p.sources?.install ?? p.sources?.compose ?? null,
  },
].filter((f) => typeof f.text === 'string' && f.text.length > 0);

const citations = (p.citations ?? []).filter((c) => c?.url);

// The mirror is keyed by the SaaS slug, like the page it mirrors — /self-host/
// miro.md, never /self-host/excalidraw.md, which now only exists as a 301.
const mirrorHref = `/self-host/${page.slug}.md`;
---

<Base {title} {description} {jsonld} ogImage={`/og/${page.slug}.png`}>
  <article class="project">
    <!-- ── head ─────────────────────────────────────────────────────── -->
    <header class="ph blueprint">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href={`/category/${page.category}/`}>{page.categoryLabel}</a></li>
            <li><span aria-current="page">{page.name}</span></li>
          </ol>
        </nav>

        <div class="ph-verdict">
          <h1>Can I self-host {page.name}?</h1>
          <TierBadge tier={page.tier} label={`${page.verdictWord} · ${page.tierLabel}`} size="lg" />
        </div>

        <p class="ph-answer">{directAnswer}</p>

        <ul class="ph-meta" aria-label={`About ${page.name}`}>
          {
            page.domain && (
              <li>
                <a class="chip mono" href={`https://${page.domain}`} rel="noopener nofollow">
                  {page.domain}
                </a>
              </li>
            )
          }
          <li>
            <a class="chip" href={`/category/${page.category}/`}>{page.categoryLabel}</a>
          </li>
          {pricing.checkedOn && <li class="chip mono">prices checked {pricing.checkedOn}</li>}
        </ul>
      </div>
    </header>

    <!-- ── why people pay for it ────────────────────────────────────── -->
    <section class="section pj-why" id="why-people-pay" aria-labelledby="why-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="why-h">Why people pay for {page.name}</h2>
            <p class="section-note">
              Stated as the vendor would want it stated. A replacement you pick without knowing
              what the subscription actually buys is a replacement you abandon in a fortnight.
            </p>
          </div>
        </div>

        {page.whyPeoplePay && <p class="why-prose">{page.whyPeoplePay}</p>}

        {
          page.plans.length > 0 && (
            <div class="ladder-scroll">
              <table class="ladder">
                <caption class="sr-only">{page.name} plans and list prices</caption>
                <thead>
                  <tr>
                    <th scope="col">Plan</th>
                    <th scope="col">List price</th>
                    <th scope="col">What it buys</th>
                  </tr>
                </thead>
                <tbody>
                  {page.plans.map((plan) => (
                    <tr class={swap && plan.name === swap.plan ? 'is-swap' : undefined}>
                      <th scope="row">
                        <span class="ladder-plan">{plan.name}</span>
                        {swap && plan.name === swap.plan && (
                          <span class="ladder-tag">the plan this page prices against</span>
                        )}
                      </th>
                      <td class="ladder-price mono">{planPrice(plan)}</td>
                      <td class="ladder-note">{plan.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        <p class="provenance ladder-prov">
          Vendor list prices{pricing.currency ? ` in ${pricing.currency}` : ''}
          {
            pricing.source ? (
              <>
                , read from <a href={pricing.source} rel="noopener nofollow">the pricing page</a>
              </>
            ) : null
          }
          {pricing.checkedOn ? ` on ${pricing.checkedOn}` : ''}
          {pricing.confidence ? ` · confidence: ${pricing.confidence}` : ''}
        </p>

        {
          showCaveat && (
            <aside class={lowConfidence ? 'pricing-caveat is-low' : 'pricing-caveat'}>
              <p class="microlabel">
                {lowConfidence ? 'Low-confidence price' : 'How this price was read'}
              </p>
              <p>{caveatNote}</p>
            </aside>
          )
        }
      </div>
    </section>

    <!-- ── the replacement ──────────────────────────────────────────── -->
    <section class="section pj-repl" id="the-replacement" aria-labelledby="repl-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="repl-h">Replaced by {p.name}</h2>
            <p class="section-note">
              One project, named before the prompt, so you know what you are about to install.
            </p>
          </div>
        </div>

        <p class="repl-tagline">{p.tagline}</p>

        <ul class="ph-meta repl-meta" aria-label={`Facts about ${p.name}`}>
          {p.license && <li class="chip mono">{p.license}</li>}
          {
            p.repo && (
              <li>
                <a class="chip mono" href={`https://github.com/${p.repo}`} rel="noopener">
                  {p.repo}
                </a>
              </li>
            )
          }
          {
            composeLabel && (
              <li>
                {p.officialComposeUrl ? (
                  <a class="chip" href={p.officialComposeUrl} rel="noopener">{composeLabel}</a>
                ) : (
                  <span class="chip">{composeLabel}</span>
                )}
              </li>
            )
          }
          {p.arm64 !== null && <li class="chip">{p.arm64 ? 'runs on arm64' : 'amd64 only'}</li>}
        </ul>

        {pickRationale && <p class="repl-why">{pickRationale}</p>}
      </div>
    </section>

    <!-- ── the ranking, when there is more than one candidate ───────── -->
    {
      page.options.length > 1 && (
        <section class="section pj-ranked" id="ranked" aria-labelledby="ranked-h">
          <div class="wrap">
            <div class="section-head">
              <div>
                <h2 id="ranked-h">What else we looked at</h2>
                <p class="section-note">
                  Ranked, with the reason each one placed where it did. Only the pick has a
                  prompt on this page — the runners-up are named so the choice is visible, not
                  hidden.
                </p>
              </div>
            </div>
            <ol class="ranked" role="list">
              {page.options.map((o, i) => (
                <li class={i === 0 ? 'rk is-pick' : 'rk'}>
                  <div class="rk-top">
                    <span class="rk-name">{o.name}</span>
                    {i === 0 && <span class="rk-pick microlabel">our pick</span>}
                    <TierBadge tier={o.tier} label={o.tierLabel} />
                  </div>
                  <p class="rk-tagline">{o.tagline}</p>
                  {o.rationale && <p class="rk-why">{o.rationale}</p>}
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <!-- ── the swap ─────────────────────────────────────────────────── -->
    <section class="section pj-swap" aria-labelledby="swap-h">
      <div class="wrap">
        <h2 class="microlabel" id="swap-h">The swap</h2>
        <SwapBand
          payingName={page.name}
          payingPrice={swapPriced ? `${monthlyLine} · ${yearlyLine}` : 'no list price to quote'}
          runningName={p.name}
          runningMeta={swapMeta}
        />
        <p class="provenance swap-prov">
          {swap?.plan && <>{page.name} {swap.plan}{qualifier ? ` · ${qualifier}` : ''} · </>}
          {
            swapPriced ? (
              <>
                vendor list price
                {swap.priceCheckedOn ? <> · checked {swap.priceCheckedOn}</> : null}
                {swap.priceSource ? (
                  <> · <a href={swap.priceSource} rel="noopener nofollow">source</a></>
                ) : null}
                {swap.priceConfidence && swap.priceConfidence !== 'high' ? (
                  <> · confidence: {swap.priceConfidence}</>
                ) : null}
              </>
            ) : (
              <>no like-for-like list price on the vendor's page, so this page quotes none</>
            )
          }
        </p>
      </div>
    </section>

    <!-- ── before you start ─────────────────────────────────────────── -->
    <section class="section pj-bys" aria-labelledby="bys-h">
      <div class="wrap">
        <h2 class="microlabel" id="bys-h">Before you start</h2>
        <BeforeYouStart
          ramMinMB={p.ramMinMB}
          ramMeasuredMB={p.ramMeasuredMB}
          diskGB={p.diskGB}
          needsDns={p.tierFactors?.needsDns ?? false}
          timeToRunningMin={p.timeToRunningMin}
          bandLabel={bandLabel}
        />
      </div>
    </section>

    <!-- ── the prompt, and the notice that has to sit above it ──────── -->
    <section class="section pj-prompt" id="the-prompt" aria-labelledby="prompt-h">
      <div class="wrap">
        {
          isVerified ? (
            <p class="stamp verify-stamp">
              Tested on a clean machine
              {p.verified?.date ? ` · ${p.verified.date}` : ''}
              {p.verified?.version ? ` · ${p.verified.version}` : ''}
              {p.verified?.host ? ` · ${p.verified.host}` : ''}
            </p>
          ) : (
            <aside class="unverified" aria-labelledby="unverified-h">
              <p class="microlabel" id="unverified-h">Not yet verified on a clean machine</p>
              <p>
                Every config here was authored from the upstream docs and passes our static checks —
                but no harness run has stamped this page yet. The verification system is described on{' '}
                <a href="/methodology/">/methodology</a>.
              </p>
              <p class="unverified-ask">
                Ran it? Tell us:{' '}
                <a href={`${SITE.repoUrl}/issues/new/choose`} rel="noopener">
                  open an issue
                </a>{' '}
                with what worked and what did not. That is how this page earns its stamp.
              </p>
            </aside>
          )
        }

        <div class="section-head">
          <div>
            <h2 id="prompt-h">The prompt</h2>
            <p class="section-note">
              Two paths to the same {p.name}: the cloud one assumes Prompt Zero is done on a server
              you rent, the local one assumes nothing but a computer that can run Docker Desktop.
              Read whichever you pick before you paste it, which is the whole reason both are on the
              page instead of behind a download.
            </p>
          </div>
        </div>

        <PromptBox
          name={p.name}
          slug={p.slug}
          prompt={files.prompt}
          promptChat={files.promptChat}
          promptLocal={files.promptLocal}
          local={p.local ?? null}
          composeLocal={files.composeLocal}
          composeSource={p.sources?.compose ?? null}
          mirrorHref={mirrorHref}
        />
      </div>
    </section>

    <!-- ── deterministic fallback files ─────────────────────────────── -->
    {
      fallbacks.length > 0 && (
        <section class="section pj-files" id="the-files" aria-labelledby="files-h">
          <div class="wrap">
            <div class="section-head machine">
              <div>
                <h2 id="files-h">The files, if you'd rather do it yourself</h2>
                <p class="section-note">
                  The cloud path with no agent involved: three files, in the order you'd use them.
                  The cloud prompt above writes exactly these — if the two ever disagree, the files
                  are the ones CI diffs. The local path ships its own compose file, collapsed under
                  its own prompt.
                </p>
              </div>
            </div>
            <div class="ff-list">
              {fallbacks.map((f) => (
                <FallbackFile
                  filename={f.filename}
                  text={f.text}
                  id={f.id}
                  summary={f.summary}
                  sourceUrl={f.sourceUrl}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ── what you're signing up for ───────────────────────────────── -->
    {
      (p.whatYouSignUpFor ?? []).length > 0 && (
        <section class="section pj-candor" id="signing-up" aria-labelledby="candor-h">
          <div class="wrap">
            <div class="section-head">
              <div>
                <h2 id="candor-h">What you're signing up for</h2>
                <p class="section-note">
                  The part a vendor's comparison page leaves out. None of it is a reason not to do
                  this; all of it is yours the moment you cancel {page.name}.
                </p>
              </div>
            </div>
            <ul class="candor">
              {p.whatYouSignUpFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ── provenance: the quote and the citations ──────────────────── -->
    {
      (p.quote?.text || citations.length > 0) && (
        <section class="section pj-sources" aria-labelledby="sources-h">
          <div class="wrap">
            <h2 class="microlabel" id="sources-h">Where this came from</h2>
            {p.quote?.text && (
              <blockquote class="pj-quote machine">
                <p>“{p.quote.text}”</p>
                <footer class="provenance">
                  —{' '}
                  {p.quote.url ? (
                    <a href={p.quote.url} rel="noopener">{p.quote.source}</a>
                  ) : (
                    p.quote.source
                  )}
                  {p.quote.checkedOn ? ` · read ${p.quote.checkedOn}` : ''}
                </footer>
              </blockquote>
            )}
            {citations.length > 0 && (
              <ul class="cites">
                {citations.map((c) => (
                  <li>
                    <span class="cite-claim">{c.claim}</span>{' '}
                    <a class="cite-link mono" href={c.url} rel="noopener">source</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      )
    }

    <!-- ── related ──────────────────────────────────────────────────── -->
    {
      related.length > 0 && (
        <section class="section pj-related" aria-labelledby="related-h">
          <div class="wrap">
            <div class="section-head">
              <div>
                <h2 id="related-h">Other invoices worth reading</h2>
                <p class="section-note">
                  Same shelf, same kind of evening. Each one has its own answer and its own prompt.
                </p>
              </div>
            </div>
            <ul class="mini-cards" role="list">
              {related.map((r) => (
                <li>
                  <a class="mini-card" href={`/self-host/${r.slug}/`}>
                    <span class="mc-top">
                      <span class="mc-name">{r.name}</span>
                      <TierBadge tier={r.tier} label={r.tierLabel} />
                    </span>
                    <span class="mc-tagline">
                      Replaced by {r.primary.name} — {r.primary.tagline}
                    </span>
                    <span class="mc-cta mono">Can I self-host {r.name}? →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ── faq ──────────────────────────────────────────────────────── -->
    <section class="section pj-faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="faq-h">Questions people actually ask</h2>
            <p class="section-note">
              Answered from this page's own data — the same numbers, in sentences.
            </p>
          </div>
        </div>
        <ProjectFaq faqs={faqs} />
        <p class="provenance faq-foot">
          Content last checked {page.contentUpdatedAt}. Verdicts are derived from the published
          rubric on <a href="/methodology/">/methodology</a>; corrections go through{' '}
          <a href={`${SITE.repoUrl}/issues/new/choose`} rel="noopener">the issue tracker</a>.
        </p>
      </div>
    </section>
  </article>
</Base>
