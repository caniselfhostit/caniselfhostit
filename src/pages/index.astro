---
import Base from '../layouts/Base.astro';
import DirectoryRow from '../components/DirectoryRow.astro';
import SwapBand from '../components/SwapBand.astro';
import { SITE } from '../lib/site.js';
import { getAllSaasPages, CATEGORY_LIST } from '../lib/projects.js';

// The directory is keyed by the PAID app: the row is Miro, and Excalidraw is
// what answers it. Source order is the ranking — the data layer owns editorial
// `pagePriority` (disclosed on /methodology), and re-sorting here would silently
// override it.
const pages = getAllSaasPages() ?? [];
const count = pages.length;

// The closed category enum, from the one source of truth (rubric.js). Rendered
// as plain chips, not links: the hub pages ship with the first cohort, and a
// directory that leads with dead links is exactly the kind of thing this site
// exists to complain about.
const CATEGORIES = CATEGORY_LIST.map((c) => c.label);

const money = (n) =>
  `$${n.toLocaleString('en-US', {
    minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;

// The featured Swap is data-driven or absent — no invented example prices. It is
// the highest-ranked page that has an honest figure, and it quotes `page.swap`,
// the same object its row and its page quote.
const featured = pages.find(
  (s) => s.swap && typeof s.swap.monthlyCost === 'number' && s.swap.monthlyCost > 0
);
const featuredMeta = featured
  ? [
      featured.primary.tierLabel,
      featured.primary.timeToRunningMin
        ? `~${featured.primary.timeToRunningMin} min to running`
        : null,
      featured.primary.ramMinMB ? `${featured.primary.ramMinMB} MB RAM` : null,
    ]
      .filter(Boolean)
      .join(' · ')
  : '';

const year = new Date().getFullYear();
const title = `${SITE.name} — the SaaS-to-self-hosted directory (${year})`;
const description = SITE.description;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.shortName,
    url: SITE.origin,
    description: SITE.description,
  },
];

if (count > 0) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'The Rack',
    description: 'Paid SaaS, and the self-hostable open-source replacement for each one.',
    numberOfItems: count,
    // The list is the paid apps, and each URL is that app's answer page.
    itemListElement: pages.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `${SITE.origin}/self-host/${s.slug}/`,
    })),
  });
}
---

<Base {title} {description} {jsonld} ogImage="/og/home.png">
  <section class="hero blueprint">
    <div class="wrap hero-inner">
      {count > 0 && <p class="microlabel hero-eyebrow">The Rack · {count} paid apps answered</p>}
      <h1>Can I self-host <span class="blank">___</span>?</h1>
      <p class="hero-sub">{SITE.tagline}</p>
      <p class="promise machine">{SITE.promise}</p>
    </div>
  </section>

  {
    featured && (
      <section class="wrap swap-feature">
        <p class="microlabel swap-feature-label">The swap</p>
        <SwapBand
          payingName={featured.name}
          payingPrice={`${money(featured.swap.monthlyCost)}/mo`}
          runningName={featured.primary.name}
          runningMeta={featuredMeta}
        />
      </section>
    )
  }

  <section class="section" id="the-rack">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>The Rack</h2>
          <p class="section-note">
            Every entry: what you'd stop paying, what you'd run instead, and how much of your
            evening it costs to get there.
          </p>
        </div>
      </div>

      <ul class="chips" aria-label="Categories">
        {CATEGORIES.map((c) => <li class="chip">{c}</li>)}
      </ul>
      <p class="chips-note">
        Category pages open with the first cohort — these are the shelves, not links yet.
      </p>

      <div class="rack">
        <div class="rack-head" aria-hidden="true">
          <span class="c-rank microlabel">#</span>
          <span class="c-project microlabel">App</span>
          <span class="c-replaces microlabel">Replaced by</span>
          <span class="c-price microlabel">You'd stop paying</span>
          <span class="c-tier microlabel">Setup</span>
        </div>

        {
          count > 0 ? (
            pages.map((s, i) => <DirectoryRow page={s} rank={i + 1} />)
          ) : (
            <div class="rack-empty">
              <p>The Rack is being stocked — 50 verified projects landing soon.</p>
            </div>
          )
        }
      </div>

      <div class="rack-foot">
        {
          count > 0 && (
            <p class="provenance">
              Rank is editorial, and the basis is written down on{' '}
              <a href="/methodology/">/methodology</a>. Prices are vendor list prices in USD; the
              plan and the seat assumption behind each figure are on the app's own page.
            </p>
          )
        }
        <p class="section-note rack-cta">
          Paying for something that belongs here? <a href="/contribute/">Send it in</a> — the data,
          the prompts, and the harness are all open.
        </p>
      </div>
    </div>
  </section>
</Base>
